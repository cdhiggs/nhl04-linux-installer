{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "appimage",
    "externalBin": [
      ".sidecar/7zzs",
      ".sidecar/nhl-04-curl",
      ".sidecar/nhl-04-xdg-open",
      ".sidecar/nhl-04-install",
      ".sidecar/nhl-04-verify-install",
      ".sidecar/nhl-04-patch",
      ".sidecar/nhl-04-roster-install",
      ".sidecar/winetricks"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "nhl04-linux-installer",
  "mainBinaryName": "nhl04-linux-installer",
  "version": "0.4.0",
  "identifier": "com.jeremieamano.nhl04",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "nhl04-linux-installer",
        "width": 800,
        "height": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}